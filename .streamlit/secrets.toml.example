# Copy to .streamlit/secrets.toml and fill in. NEVER commit secrets.toml.
# On Streamlit Community Cloud: paste this into the app's Secrets settings.
# Keys are read SERVER-SIDE; the UI only shows a model picker (no key field).
# Only providers with a non-empty key appear in the picker.

# --- Access control -------------------------------------------------------
# Shared password for the public link (leave empty = no gate).
APP_PASSWORD = ""

# --- Conversation / escalation / feedback logging -------------------------
# Recommended (free, no GCP): a Google Apps Script Web App that appends to your
# Google Sheet. Deploy tools/apps_script_logger.gs, paste its /exec URL here.
# If empty, the app falls back to local CSV (ephemeral on Streamlit Cloud).
LOG_WEBHOOK_URL = ""

# --- Model providers (paste the key(s) you have) --------------------------
# Google Gemini (AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY = ""
# OpenRouter (one key → Claude / GPT / Gemini / Llama …) — https://openrouter.ai/keys
OPENROUTER_API_KEY = ""
# Groq — https://console.groq.com/keys
GROQ_API_KEY = ""
# Cerebras — https://cloud.cerebras.ai/
CEREBRAS_API_KEY = ""
